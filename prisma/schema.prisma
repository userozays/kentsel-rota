// Kentsel Rota — veri modeli
// SQLite kullanıyoruz: Prisma'da enum ve Json tipi SQLite'ta desteklenmediği için
// sabit kümeler String olarak tutulur ve src/lib/sabitler.ts içinde doğrulanır.
// Postgres'e geçiş: aşağıdaki provider'ı "postgresql" yapıp DATABASE_URL'i değiştirmek yeterli.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * ============ kimlik ve yetki ============
 */

model Kullanici {
  id         String    @id @default(cuid())
  eposta     String    @unique
  ad         String
  sifreHash  String
  rol        String    @default("OKUYUCU") // ADMIN | YONETICI | SAHA | OKUYUCU
  aktif      Boolean   @default(true)
  telefon    String    @default("")
  not        String    @default("")
  sonGiris   DateTime?
  olusturma  DateTime  @default(now())
  guncelleme DateTime  @updatedAt

  oturumlar Oturum[]
  erisimler BinaErisim[]

  @@index([rol])
}

model Oturum {
  id          String    @id
  kullaniciId String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)
  bitis       DateTime
  olusturma   DateTime  @default(now())
  tarayici    String    @default("")

  @@index([kullaniciId])
  @@index([bitis])
}

/// SAHA rolündeki kullanıcıların hangi binaları görebileceği.
/// ADMIN ve YONETICI için kayıt aranmaz — hepsini görürler.
model BinaErisim {
  kullaniciId String
  binaId      String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)
  bina        Bina      @relation(fields: [binaId], references: [id], onDelete: Cascade)
  olusturma   DateTime  @default(now())

  @@id([kullaniciId, binaId])
  @@index([binaId])
}

/**
 * ============ saha verisi ============
 */

model Bina {
  id           String   @id @default(cuid())
  ad           String
  il           String   @default("İstanbul")
  ilce         String   @default("")
  mahalle      String   @default("")
  adres        String   @default("")
  ada          String   @default("")
  parsel       String   @default("")
  arsaM2       Float    @default(0)
  emsal        Float    @default(0)
  taks         Float    @default(0)
  mevcutKat    Int      @default(0)
  riskli       String   @default("yok") // sabitler.ts → RISKLI
  asamaKod     String   @default("tespit") // Asama.kod
  payda        Float    @default(1000)
  notlar       String   @default("")
  agirliklar   String   @default("{}") // JSON: { malikPayi, kira, nakdi, sure, teminat, teknik }
  agirlikKilit String   @default("") // YYYY-AA-GG — boşsa kilit yok
  olusturma    DateTime @default(now())
  guncelleme   DateTime @updatedAt

  malikler  Malik[]
  teklifler Teklif[]
  erisimler BinaErisim[]

  @@index([asamaKod])
}

model Malik {
  id         String   @id @default(cuid())
  binaId     String
  bina       Bina     @relation(fields: [binaId], references: [id], onDelete: Cascade)
  ad         String
  bb         String   @default("")
  kat        String   @default("")
  pay        Float    @default(0)
  durum      String   @default("ulasilamadi") // olumlu | kararsiz | ulasilamadi | olumsuz
  engel      String   @default("[]") // JSON dizi: EngelTuru.kod listesi
  kiraci     Boolean  @default(false)
  tel        String   @default("")
  not        String   @default("")
  sonTemas   String   @default("") // YYYY-AA-GG
  olusturma  DateTime @default(now())
  guncelleme DateTime @updatedAt

  @@index([binaId])
  @@index([durum])
}

model Muteahhit {
  id         String   @id @default(cuid())
  unvan      String
  yetkili    String   @default("")
  tel        String   @default("")
  eposta     String   @default("")
  vergiNo    String   @default("")
  ymbn       String   @default("B")
  referans   String   @default("")
  durum      String   @default("degerlendirmede") // aktif | degerlendirmede | kara
  nda        Boolean  @default(false)
  ndaTarih   String   @default("")
  taahhut    Boolean  @default(false)
  not        String   @default("")
  olusturma  DateTime @default(now())
  guncelleme DateTime @updatedAt

  teklifler Teklif[]
}

model Teklif {
  id          String    @id @default(cuid())
  binaId      String
  bina        Bina      @relation(fields: [binaId], references: [id], onDelete: Cascade)
  muteahhitId String
  muteahhit   Muteahhit @relation(fields: [muteahhitId], references: [id], onDelete: Restrict)
  malikPayi   Float     @default(0)
  kiraAy      Float     @default(0)
  kiraTutar   Float     @default(0)
  nakdi       Float     @default(0)
  sureAy      Float     @default(0)
  teminat     Float     @default(0)
  teknik      Float     @default(70)
  tarih       String    @default("")
  not         String    @default("")
  olusturma   DateTime  @default(now())
  guncelleme  DateTime  @updatedAt

  @@index([binaId])
  @@index([muteahhitId])
}

/**
 * ============ sistem ayarları / sözlükler ============
 */

model Asama {
  kod       String  @id
  ad        String
  sira      Int     @default(0)
  aktif     Boolean @default(true)
  /// Kart panosunda boş olsa bile sütun gösterilsin mi
  hepGoster Boolean @default(true)
}

model EngelTuru {
  kod   String  @id
  ad    String
  sira  Int     @default(0)
  aktif Boolean @default(true)
}

model Ayar {
  anahtar    String   @id
  deger      String
  guncelleme DateTime @updatedAt
}
